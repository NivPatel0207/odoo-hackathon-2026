# =========================================
# DEVELOPMENT ENVIRONMENT
# =========================================
NODE_ENV=development
PORT=5000

# Database (Local/Docker)
MONGO_URI=mongodb://localhost:27017/transitops_dev

# JWT Secrets
JWT_SECRET=INJECT_JWT_SECRET_AT_RUNTIME
JWT_EXPIRE=30d

# Encryption Keys (Data at Rest)
ENCRYPTION_SECRET=INJECT_ENCRYPTION_SECRET_AT_RUNTIME
