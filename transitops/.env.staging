# =========================================
# STAGING ENVIRONMENT (PRE-PROD)
# =========================================
NODE_ENV=staging
PORT=5000

# Database (Staging Cluster)
MONGO_URI=INJECT_MONGO_URI_AT_RUNTIME

# JWT Secrets (Strictly different from Dev/Prod)
JWT_SECRET=INJECT_JWT_SECRET_AT_RUNTIME
JWT_EXPIRE=1d

# Encryption Keys
ENCRYPTION_SECRET=INJECT_ENCRYPTION_SECRET_AT_RUNTIME
