# =========================================
# PRODUCTION ENVIRONMENT
# =========================================
NODE_ENV=production
PORT=5000

# Database (Production Cluster - High Availability)
MONGO_URI=mongodb+srv://prod_user:PROD_PASSWORD_INJECT_AT_RUNTIME@cluster0.mongodb.net/transitops_prod

# JWT Secrets (Strictly injected at runtime via Secrets Manager)
JWT_SECRET=PROD_JWT_SECRET_INJECT_AT_RUNTIME
JWT_EXPIRE=1h

# Encryption Keys (Strictly injected at runtime via AWS KMS/HashiCorp Vault)
ENCRYPTION_SECRET=PROD_ENCRYPTION_SECRET_INJECT_AT_RUNTIME
